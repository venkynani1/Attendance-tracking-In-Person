# Supabase → Connect → "Transaction pooler" (port 6543). Keep the two query params at the end.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase → Connect → "Session pooler" (port 5432). Used to create the tables.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Long random string used to sign login sessions (at least 32 characters).
JWT_SECRET="replace-with-a-long-random-secret"

# One-time key you type on /setup to create the master admin account.
SETUP_KEY="replace-with-a-setup-key"
